// Nyx standard library, random module.
// A fast xorshift64 generator. Same seed, same sequence, on every machine.
// import "random"

struct Rng {
    state: u64,
}

impl Rng {
    fn new(seed: u64) -> Rng {
        if seed == 0 {
            return Rng { state: 0x9E37_79B9_7F4A_7C15 }
        }
        return Rng { state: seed }
    }

    // Next raw 64 bit value.
    fn next(var self) -> u64 {
        var x = self.state
        x ^= x << 13
        x ^= x >> 7
        x ^= x << 17
        self.state = x
        return x
    }

    // Integer in the range lo up to but not including hi.
    fn range(var self, lo: i64, hi: i64) -> i64 {
        if hi <= lo {
            return lo
        }
        return lo + (self.next() % (hi - lo) as u64) as i64
    }

    // Float between 0 and 1.
    fn float(var self) -> f64 {
        return (self.next() >> 11) as f64 / 9007199254740992.0
    }

    fn chance(var self, p: f64) -> bool {
        return self.float() < p
    }
}
