// Real strings, with concatenation, comparison and the strings module.
import "strings"

fn greet(name: str) -> str {
    return "Hello, " + name + "!"
}

fn main() {
    print(greet("Nyx"))

    let level = 7
    let msg = "Level " + str(level) + " unlocked, speed " + str(1.5) + "x"
    print(msg)
    print("length of msg is", msg.len())

    let csv = "sword,shield, potion ,bow"
    let items = split(csv, ",")
    for item in items {
        print("item", "[" + trim(item) + "]")
    }
    print(join(items, " | "))
    print(to_upper("game over"))
    print(repeat("=", 20))

    print("starts with sword?", starts_with(csv, "sword"))
    print("has potion?", csv.contains("potion"))
    print("apple" < "banana", "nyx" == "nyx")

    var word = ""
    for c in "abc" {
        word = chr(c) + word
    }
    print("reversed", word)
}
