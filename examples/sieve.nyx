// Sieve of Eratosthenes with a fixed size array.
// Array access is bounds checked at runtime.

fn main() {
    var is_prime = [true; 100]
    is_prime[0] = false
    is_prime[1] = false
    let n = len(is_prime)
    var i = 2
    while i * i < n {
        if is_prime[i] {
            var j = i * i
            while j < n {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    var count = 0
    for k in 0..n {
        if is_prime[k] {
            count += 1
        }
    }
    print("primes below", n, "=", count)
}
